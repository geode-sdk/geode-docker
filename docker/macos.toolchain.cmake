message(STATUS "MacOS toolchain loaded")

set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
if(NOT DEFINED CMAKE_OSX_DEPLOYMENT_TARGET)
    set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0)
endif()
set(CMAKE_OSX_SYSROOT $ENV{OSXCROSS_SDK_PATH})
set(CMAKE_C_COMPILER /osxcross/bin/$ENV{OSXCROSS_TARGET}-clang)
set(CMAKE_CXX_COMPILER /osxcross/bin/$ENV{OSXCROSS_TARGET}-clang++)
set(CMAKE_AR /osxcross/bin/$ENV{OSXCROSS_TARGET}-ar)
set(CMAKE_RANLIB /osxcross/bin/$ENV{OSXCROSS_TARGET}-ranlib)
set(CMAKE_FIND_ROOT_PATH /osxcross)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# used for LTO
set(CMAKE_CXX_COMPILER_AR llvm-ar)
set(CMAKE_CXX_COMPILER_RANLIB llvm-ranlib)
set(CMAKE_C_COMPILER_AR llvm-ar)
set(CMAKE_C_COMPILER_RANLIB llvm-ranlib)

set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=lld")

if(NOT DEFINED CMAKE_CXX_SCAN_FOR_MODULES)
    set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
endif()

list(APPEND _CTF_NATIVE_DEFAULT "-DCMAKE_ASM_COMPILER=/usr/bin/clang")
list(APPEND _CTF_NATIVE_DEFAULT "-DCMAKE_C_COMPILER=/usr/bin/clang")
list(APPEND _CTF_NATIVE_DEFAULT "-DCMAKE_CXX_COMPILER=/usr/bin/clang++")

set(CROSS_TOOLCHAIN_FLAGS_NATIVE "${_CTF_NATIVE_DEFAULT}" CACHE STRING "")
