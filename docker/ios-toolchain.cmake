set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_DEPLOYMENT_TARGET "14.0")
set(CMAKE_OSX_SYSROOT THEOS_SDK_PATH)
set(CMAKE_C_COMPILER OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-clang)
set(CMAKE_CXX_COMPILER OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-clang++)
set(CMAKE_OBJC_COMPILER OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-clang)
set(CMAKE_OBJCXX_COMPILER OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-clang++)
set(FLAGS "-target arm64-apple-ios14.0 -miphoneos-version-min=14.0 -Wno-overriding-option")
set(CMAKE_C_FLAGS_INIT "\${FLAGS}")
set(CMAKE_CXX_FLAGS_INIT "\${FLAGS}")
set(CMAKE_OBJC_FLAGS_INIT "\${FLAGS}")
set(CMAKE_OBJCXX_FLAGS_INIT "\${FLAGS}")
set(CMAKE_C_LINK_FLAGS "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_CXX_LINK_FLAGS "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_OBJC_LINK_FLAGS "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_OBJCXX_LINK_FLAGS "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-fuse-ld=OSXCROSS_ROOT/target/bin/arm64-apple-darwin25.1-ld")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
